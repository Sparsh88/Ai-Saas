# Server Configuration
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# PostgreSQL Database Connection (e.g. Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_HOST:5432/YOUR_DB_NAME?sslmode=require"

# JWT Secrets (Generate secure random strings for production)
JWT_ACCESS_SECRET="your_super_secret_jwt_access_key"
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key"
JWT_ACCESS_EXPIRY="30d"
JWT_REFRESH_EXPIRY="90d"

# Google Gemini API Key
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Cloudinary Storage Configuration (Optional - for persistent cloud uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
